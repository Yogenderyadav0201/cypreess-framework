pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Install Dependencies') {
            steps {
                dir('Cypress-Framework') {
                    sh 'npm install'
                }
            }
        }
        
        stage('Verify Cypress') {
            steps {
                dir('Cypress-Framework') {
                    sh 'npx cypress verify'
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                dir('Cypress-Framework') {
                    sh 'npx cypress run'
                }
            }
        }
    }
}